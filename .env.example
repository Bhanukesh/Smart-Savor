# Copy to .env. Matches docker-compose.yml. Next.js loads this automatically (server-side only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartsavor?schema=public"

# Required for any upload/Coach feature to actually call Claude (see CLAUDE.md).
ANTHROPIC_API_KEY=""

# Required by `npm run db:seed` — a real Google/Microsoft-backed email that becomes the
# seeded demo dietitian's sign-in identity (Clerk needs a real account, not a placeholder).
DIETITIAN_BOOTSTRAP_EMAIL=""

# Dietitian auth (Clerk) — see CLAUDE.md and https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Patient auth — a SECOND, separate Clerk app from the dietitian one above (see CLAUDE.md for
# why two apps, not one). Google only, unrestricted. Also doubles as invite delivery — Clerk
# sends the sign-up email itself, no Resend/Twilio needed. Optional — missing either key just
# disables patient signup (falls back to sharing the raw invite link/code manually).
NEXT_PUBLIC_PATIENT_CLERK_PUBLISHABLE_KEY=""
PATIENT_CLERK_SECRET_KEY=""

# Required by clerkMiddleware's multi-tenant key resolution (proxy.ts, routes /invite/* to the
# patient app above, everything else to the dietitian app) — encrypts the dynamic secretKey it
# propagates per-request. Not tied to any Clerk account; generate once with
# `openssl rand --hex 32` and keep it stable.
CLERK_ENCRYPTION_KEY=""
