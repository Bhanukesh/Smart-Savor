# Copy to .env. Matches docker-compose.yml. Next.js loads this automatically (server-side only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartsavor?schema=public"

# Required for any upload/Coach feature to actually call Claude (see CLAUDE.md).
ANTHROPIC_API_KEY=""

# Required by `npm run db:seed` — a real Google/Microsoft-backed email that becomes the
# seeded demo dietitian's sign-in identity (Clerk needs a real account, not a placeholder).
DIETITIAN_BOOTSTRAP_EMAIL=""

# Dietitian auth (Clerk) — see CLAUDE.md and https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Patient invite signup — real Google Sign-In (direct OAuth2, deliberately not Clerk; see
# lib/auth/googleOAuth.ts for why) and real Twilio Verify OTP over phone. Both optional —
# missing either just disables that one signup path (see lib/sms.ts / lib/auth/googleOAuth.ts).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""
