// Smart Savor — Prisma schema.
// Phase 2 slice: the tables behind the USP flow (prioritize → ratify → choose).
// Mirrors docs/Background/er-design.md (23 tables total); the rest land in later increments.
// Prisma models are camelCase; @@map/@map pin the DB names to the snake_case design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Severity {
  severe
  moderate
  mild
}

enum ApprovedListStatus {
  draft
  ratified
}

// approved_list_items has no explicit status column in the full schema (it's derived from
// comorbidity_flag + removed_at). The slice carries an explicit enum for the ratify screen;
// this collapses back to those columns when the full clinical model lands.
enum ItemStatus {
  approved
  flagged
  excluded
}

// --- Consumption logging, receipts, cycle history, messaging, onboarding (2026-08-08 increment) ---

enum ReceiptParseStatus {
  pending
  parsed
  failed
  needs_review
}

enum ReceiptLineMatchFlag {
  ok
  needs_review
  ambiguous
  no_match
}

enum HabitSource {
  receipt
  manual
  none
}

enum ConsumptionSource {
  photo
  voice
  text
  nudge_confirmed
  inferred
}

enum ConsumptionFlag {
  ok
  needs_review
}

enum FocusItemOutcomeStatus {
  in_progress
  closed
  carried_forward
  deferred
}

enum AdherenceClassification {
  adherent
  partial
  non_adherent
}

enum MessageSender {
  patient
  dietitian
}

enum UserRole {
  dietitian
  patient
}

model Practice {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  dietitians Dietitian[]
  patients   Patient[]

  @@map("practices")
}

model Dietitian {
  id         String   @id @default(uuid()) @db.Uuid
  practiceId String   @map("practice_id") @db.Uuid
  practice   Practice @relation(fields: [practiceId], references: [id])
  name       String
  credential String?
  email      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  patients   Patient[]
  messages      Message[]
  invitesIssued PatientInvite[]
  user          User?

  @@map("dietitians")
}

model Patient {
  id           String   @id @default(uuid()) @db.Uuid
  practiceId   String   @map("practice_id") @db.Uuid
  practice     Practice @relation(fields: [practiceId], references: [id])
  // Slice simplification: a single primary dietitian FK. The full model uses the
  // patient_dietitians join table (primary + co-management + history).
  dietitianId  String?  @map("dietitian_id") @db.Uuid
  dietitian    Dietitian? @relation(fields: [dietitianId], references: [id])
  name         String
  age          Int?
  conditions   String[] @default([])
  // Dietary preferences (ER design 3.3): food-sourcing agent reads these as a simple list.
  restrictions String[] @default([]) // e.g. ["vegetarian"]
  dislikes     String[] @default([]) // e.g. ["mushrooms"]
  weeklyBudgetUsd Decimal? @map("weekly_budget_usd") @db.Decimal(8, 2)
  bmi          Decimal? @db.Decimal(5, 2)
  bpSystolic   Int?     @map("bp_systolic")
  bpDiastolic  Int?     @map("bp_diastolic")
  weeklyNudgeEnabled Boolean @default(true) @map("weekly_nudge_enabled")
  // Headline biomarkers for the snapshot card. Full model normalizes these into
  // lab_reports + lab_analytes; the slice keeps a display-only JSON array.
  labs         Json?
  enrolledAt   DateTime? @map("enrolled_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  nutrientGaps    NutrientGap[]
  cycles          Cycle[]
  approvedLists   ApprovedList[]
  patientChoices  PatientChoice[]
  receipts          Receipt[]
  labReports        LabReport[]
  habitModel        HabitModel[]
  consumptionEvents ConsumptionEvent[]
  weightCheckIns    WeightCheckIn[]
  messages          Message[]
  invite            PatientInvite?
  user              User?

  @@index([practiceId])
  @@map("patients")
}

model NutrientGap {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  patient      Patient  @relation(fields: [patientId], references: [id])
  nutrient     String
  label        String
  currentValue Decimal  @map("current_value") @db.Decimal(10, 4)
  targetValue  Decimal  @map("target_value") @db.Decimal(10, 4)
  unit         String
  severity     Severity
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  focusItems     FocusSetItem[]
  approvedLists  ApprovedList[]
  patientChoices PatientChoice[]
  cycleOutcomes  CycleOutcome[]

  @@unique([patientId, nutrient])
  @@index([patientId])
  @@map("nutrient_gaps")
}

model Cycle {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  patient          Patient  @relation(fields: [patientId], references: [id])
  cycleSlug        String?  @map("cycle_slug")
  startDate        DateTime @map("start_date") @db.Date
  retestDueDate    DateTime @map("retest_due_date") @db.Date
  status           String   @default("active")
  focusSetVersion  Int      @default(0) @map("focus_set_version")
  // Set when the dietitian confirms this cycle's ranked focus set (D1.5 gesture).
  focusSetConfirmedAt DateTime? @map("focus_set_confirmed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  focusItems     FocusSetItem[]
  patientChoices PatientChoice[]
  // Linked-list of cycles per patient (ER design 3.6) — chronic care repeats every 3 months.
  previousCycleId String? @map("previous_cycle_id") @db.Uuid
  previousCycle   Cycle?  @relation("CycleHistory", fields: [previousCycleId], references: [id])
  nextCycles      Cycle[] @relation("CycleHistory")
  outcomes        CycleOutcome[]

  @@index([patientId, status])
  @@map("cycles")
}

model FocusSetItem {
  id            String      @id @default(uuid()) @db.Uuid
  cycleId       String      @map("cycle_id") @db.Uuid
  cycle         Cycle       @relation(fields: [cycleId], references: [id])
  nutrientGapId String      @map("nutrient_gap_id") @db.Uuid
  nutrientGap   NutrientGap @relation(fields: [nutrientGapId], references: [id])
  version       Int         @default(0)
  rank          Int
  why           String
  pairWith      String?     @map("pair_with")
  conflictsWith String?     @map("conflicts_with")
  excluded      Boolean     @default(false)
  excludeReason String?     @map("exclude_reason")
  createdAt     DateTime    @default(now()) @map("created_at")

  outcomes CycleOutcome[]

  @@index([cycleId, version])
  @@map("focus_set_items")
}

model ApprovedList {
  id            String             @id @default(uuid()) @db.Uuid
  patientId     String             @map("patient_id") @db.Uuid
  patient       Patient            @relation(fields: [patientId], references: [id])
  nutrientGapId String             @map("nutrient_gap_id") @db.Uuid
  nutrientGap   NutrientGap        @relation(fields: [nutrientGapId], references: [id])
  status        ApprovedListStatus @default(draft)
  ratifiedBy    String?            @map("ratified_by")
  ratifiedAt    DateTime?          @map("ratified_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items ApprovedListItem[]

  @@unique([patientId, nutrientGapId])
  @@map("approved_lists")
}

model ApprovedListItem {
  id                 String       @id @default(uuid()) @db.Uuid
  approvedListId     String       @map("approved_list_id") @db.Uuid
  approvedList       ApprovedList @relation(fields: [approvedListId], references: [id])
  foodName           String       @map("food_name")
  fdcId              String?      @map("fdc_id")
  servingDescription String       @map("serving_description")
  prep               String       @default("")
  amountPerServing   Decimal      @map("amount_per_serving") @db.Decimal(10, 4)
  unit               String
  icon               String       @default("ph-bowl-food")
  status             ItemStatus   @default(approved)
  note               String       @default("")
  edited             Boolean      @default(false)
  rank               Int          @default(0)
  removedAt          DateTime?    @map("removed_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  patientChoices PatientChoice[]

  @@index([approvedListId])
  @@map("approved_list_items")
}

model PatientChoice {
  id                 String           @id @default(uuid()) @db.Uuid
  patientId          String           @map("patient_id") @db.Uuid
  patient            Patient          @relation(fields: [patientId], references: [id])
  cycleId            String           @map("cycle_id") @db.Uuid
  cycle              Cycle            @relation(fields: [cycleId], references: [id])
  nutrientGapId      String           @map("nutrient_gap_id") @db.Uuid
  nutrientGap        NutrientGap      @relation(fields: [nutrientGapId], references: [id])
  approvedListItemId String           @map("approved_list_item_id") @db.Uuid
  approvedListItem   ApprovedListItem @relation(fields: [approvedListItemId], references: [id])
  foodName           String           @map("food_name")
  servingsText       String           @map("servings_text")
  gapRemaining       Decimal          @map("gap_remaining") @db.Decimal(10, 4)
  gapUnit            String           @map("gap_unit")
  gapClosedPct       Decimal          @map("gap_closed_pct") @db.Decimal(5, 2)
  stillApproved      Boolean          @map("still_approved")
  chosenAt           DateTime         @default(now()) @map("chosen_at")
  supersededAt       DateTime?        @map("superseded_at")

  @@index([patientId, cycleId, nutrientGapId])
  @@map("patient_choices")
}

// --- Cycle outcome history (ER design 3.18) ---------------------------------------------

model CycleOutcome {
  id             String      @id @default(uuid()) @db.Uuid
  cycleId        String      @map("cycle_id") @db.Uuid
  cycle          Cycle       @relation(fields: [cycleId], references: [id])
  focusSetItemId String?     @map("focus_set_item_id") @db.Uuid
  focusSetItem   FocusSetItem? @relation(fields: [focusSetItemId], references: [id])
  nutrientGapId  String      @map("nutrient_gap_id") @db.Uuid
  nutrientGap    NutrientGap @relation(fields: [nutrientGapId], references: [id])
  baselineValue  Decimal     @map("baseline_value") @db.Decimal(10, 4)
  retestValue    Decimal?    @map("retest_value") @db.Decimal(10, 4)
  delta          Decimal?    @db.Decimal(10, 4)
  improved       Boolean?
  outcomeStatus  FocusItemOutcomeStatus @default(in_progress) @map("outcome_status")
  adherencePct   Decimal?    @map("adherence_pct") @db.Decimal(5, 2)
  adherenceClassification AdherenceClassification? @map("adherence_classification")
  computedAt     DateTime?   @map("computed_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@unique([cycleId, nutrientGapId])
  @@map("cycle_outcomes")
}

// --- Receipts (ER design 3.13-3.14) -----------------------------------------------------

model Receipt {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  patient      Patient  @relation(fields: [patientId], references: [id])
  uploadDate   DateTime @default(now()) @map("upload_date")
  purchasedAt  DateTime? @map("purchased_at") @db.Date
  retailer     String?
  // MVP: relative path under STORAGE_DIR (lib/storage.ts). Column name kept as the design
  // doc's s3_key so swapping in real S3 later is a one-function change, not a schema change.
  s3Key        String   @map("s3_key")
  parseStatus  ReceiptParseStatus @default(pending) @map("parse_status")
  agentRunId   String?  @map("agent_run_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lineItems         ReceiptLineItem[]
  consumptionEvents ConsumptionEvent[]

  @@index([patientId, uploadDate])
  @@map("receipts")
}

model ReceiptLineItem {
  id              String   @id @default(uuid()) @db.Uuid
  receiptId       String   @map("receipt_id") @db.Uuid
  receipt         Receipt  @relation(fields: [receiptId], references: [id])
  rawText         String   @map("raw_text")
  matchedFood     String?  @map("matched_food")
  fdcId           String?  @map("fdc_id")
  quantity        Decimal? @db.Decimal(10, 3)
  priceUsd        Decimal? @map("price_usd") @db.Decimal(10, 2)
  matchConfidence Decimal? @map("match_confidence") @db.Decimal(4, 3)
  matchFlag       ReceiptLineMatchFlag @default(ok) @map("match_flag")
  // DEVIATION from er-design.md: added so the patient can review/exclude items that aren't
  // theirs (e.g. a family member's purchase). null = awaiting review · true = confirmed
  // mine · false = excluded. Only confirmed=true items feed the habit model.
  confirmed       Boolean?
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([receiptId])
  @@map("receipt_line_items")
}

// --- Lab reports / Health Report Analyzer agent (2026-08-08 increment) -----------------
// Mirrors Receipt/ReceiptLineItem exactly: an upload lands as draft findings (confirmed:
// null), the model only transcribes what's on the page, and a finding only becomes a real
// NutrientGap once the dietitian confirms it (see confirmLabFinding in lib/data.ts).

enum LabReportParseStatus {
  pending
  parsed
  failed
}

model LabReport {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  patient      Patient  @relation(fields: [patientId], references: [id])
  uploadDate   DateTime @default(now()) @map("upload_date")
  // Same MVP-local-disk-standing-in-for-S3 convention as Receipt.s3Key.
  s3Key        String   @map("s3_key")
  parseStatus  LabReportParseStatus @default(pending) @map("parse_status")
  createdAt    DateTime @default(now()) @map("created_at")

  findings LabReportFinding[]

  @@index([patientId, uploadDate])
  @@map("lab_reports")
}

model LabReportFinding {
  id            String    @id @default(uuid()) @db.Uuid
  labReportId   String    @map("lab_report_id") @db.Uuid
  labReport     LabReport @relation(fields: [labReportId], references: [id])
  nutrient      String
  label         String
  currentValue  Decimal   @map("current_value") @db.Decimal(10, 4)
  unit          String
  // null = awaiting dietitian review · true = confirmed, materialized into a NutrientGap ·
  // false = rejected (e.g. misread value) — same tri-state as ReceiptLineItem.confirmed.
  confirmed     Boolean?
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([labReportId])
  @@map("lab_report_findings")
}

// --- Habit model + consumption events (ER design 3.15-3.16) ----------------------------

model HabitModel {
  id           String     @id @default(uuid()) @db.Uuid
  patientId    String     @map("patient_id") @db.Uuid
  patient      Patient    @relation(fields: [patientId], references: [id])
  foodName     String     @map("food_name")
  fdcId        String?    @map("fdc_id")
  freqPerWeek  Decimal    @map("freq_per_week") @db.Decimal(5, 2)
  lastSeenDate DateTime?  @map("last_seen_date") @db.Date
  source       HabitSource @default(none)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([patientId, foodName])
  @@map("habit_model")
}

model ConsumptionEvent {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  patient          Patient  @relation(fields: [patientId], references: [id])
  foodName         String   @map("food_name")
  fdcId            String?  @map("fdc_id")
  // DEVIATION from er-design.md: quantity added — without it, per-day nutrient totals can't
  // be computed against grocery_items' per-100g values.
  quantityServings Decimal  @default(1) @map("quantity_servings") @db.Decimal(6, 2)
  rawInput         String?  @map("raw_input") @db.Text
  consumedDate     DateTime @map("consumed_date") @db.Date
  source           ConsumptionSource
  confidenceTier   Int?     @map("confidence_tier") @db.SmallInt
  matchConfidence  Decimal? @map("match_confidence") @db.Decimal(4, 3)
  flag             ConsumptionFlag @default(ok)
  sourceReceiptId  String?  @map("source_receipt_id") @db.Uuid
  sourceReceipt    Receipt? @relation(fields: [sourceReceiptId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([patientId, consumedDate])
  @@map("consumption_events")
}

// --- Weight check-ins (net new — not in er-design.md) -----------------------------------

model WeightCheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  patient     Patient  @relation(fields: [patientId], references: [id])
  weightLb    Decimal  @map("weight_lb") @db.Decimal(6, 2)
  checkedInAt DateTime @default(now()) @map("checked_in_at") @db.Date
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([patientId, checkedInAt])
  @@map("weight_check_ins")
}

// --- Messaging (net new — no prior design; single thread per patient, mirrors the -------
// --- existing single-primary-dietitian simplification, no Conversation wrapper needed) --

model Message {
  id          String       @id @default(uuid()) @db.Uuid
  patientId   String       @map("patient_id") @db.Uuid
  patient     Patient      @relation(fields: [patientId], references: [id])
  dietitianId String       @map("dietitian_id") @db.Uuid
  dietitian   Dietitian    @relation(fields: [dietitianId], references: [id])
  senderRole  MessageSender @map("sender_role")
  body        String       @db.Text
  readAt      DateTime?    @map("read_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([patientId, createdAt])
  @@index([dietitianId, readAt])
  @@map("messages")
}

// --- Onboarding: invite-code gate + Auth0-backed identity (ER design Part 1, Decisions 2-3)
// --- Auth0 verification itself is mocked behind lib/auth/verifyIdentity.ts this increment --

model PatientInvite {
  id                String    @id @default(uuid()) @db.Uuid
  patientId         String    @unique @map("patient_id") @db.Uuid
  patient           Patient   @relation(fields: [patientId], references: [id])
  code              String    @unique
  issuedBy          String    @map("issued_by") @db.Uuid
  issuedByDietitian Dietitian @relation(fields: [issuedBy], references: [id])
  expiresAt         DateTime  @map("expires_at")
  redeemedAt        DateTime? @map("redeemed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("patient_invites")
}

// Dietitian rows carry passwordHash; patient rows carry auth0UserId — mutually exclusive.
// Prisma can't express the CHECK constraint declaratively; it's hand-added to the generated
// migration SQL (see prisma/migrations/.../migration.sql) and enforced again in lib/auth/.
model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String?   @unique
  phone                    String?   @unique
  passwordHash             String?   @map("password_hash")
  auth0UserId              String?   @unique @map("auth0_user_id")
  role                     UserRole
  dietitianId              String?   @unique @map("dietitian_id") @db.Uuid
  dietitian                Dietitian? @relation(fields: [dietitianId], references: [id])
  patientId                String?   @unique @map("patient_id") @db.Uuid
  patient                  Patient?  @relation(fields: [patientId], references: [id])
  isActive                 Boolean   @default(true) @map("is_active")
  lastLoginAt              DateTime? @map("last_login_at")
  passwordResetToken       String?   @map("password_reset_token")
  passwordResetTokenExpiry DateTime? @map("password_reset_token_expiry")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// grocery_items — the Walmart x USDA price/nutrient join (ER design 3.20), 8,986 rows,
// ingested from docs/Dataset/Grocery_Nutrition.csv via `npm run db:ingest-grocery`.
//
// Deviations from the ER doc, driven by the real data (not the spec):
// - `fdcId` is NOT unique — 1,297 rows in the source share an fdc_id (multiple retail
//   products matched to the same USDA reference food). Indexed, not a unique key.
// - Nutrient columns use wider precision than the doc's NUMERIC(8,4) — some source rows
//   (e.g. sodium_mg, potassium_mg) have per-100g values in the hundreds of thousands,
//   which would overflow (8,4). Widened to avoid a repeat ingestion failure.
// - Includes sat_fat_g/mono_fat_g/poly_fat_g/trans_fat_g/product_url — present in the CSV
//   but not listed in the ER doc's column spec.
model GroceryItem {
  id                 String    @id @default(uuid()) @db.Uuid
  department         String?
  category           String?
  productName        String    @map("product_name")
  brand              String?
  priceUsd           Decimal?  @map("price_usd") @db.Decimal(10, 4)
  packageSize        String?   @map("package_size")
  pricePer100gUsd    Decimal?  @map("price_per_100g_usd") @db.Decimal(10, 6)
  productUrl         String?   @map("product_url") @db.Text
  fdcId              String    @map("fdc_id")
  usdaDescription    String?   @map("usda_description")
  usdaSource         String?   @map("usda_source")
  matchConfidence    String?   @map("match_confidence")
  servingSizeG       Decimal?  @map("serving_size_g") @db.Decimal(10, 3)
  householdServing   String?   @map("household_serving")
  caloriesKcal       Decimal?  @map("calories_kcal") @db.Decimal(10, 2)
  proteinG           Decimal?  @map("protein_g") @db.Decimal(10, 4)
  totalFatG          Decimal?  @map("total_fat_g") @db.Decimal(10, 4)
  satFatG            Decimal?  @map("sat_fat_g") @db.Decimal(10, 4)
  monoFatG           Decimal?  @map("mono_fat_g") @db.Decimal(10, 4)
  polyFatG           Decimal?  @map("poly_fat_g") @db.Decimal(10, 4)
  transFatG          Decimal?  @map("trans_fat_g") @db.Decimal(10, 4)
  cholesterolMg      Decimal?  @map("cholesterol_mg") @db.Decimal(10, 4)
  carbsG             Decimal?  @map("carbs_g") @db.Decimal(10, 4)
  fiberG             Decimal?  @map("fiber_g") @db.Decimal(10, 4)
  sugarsG            Decimal?  @map("sugars_g") @db.Decimal(10, 4)
  addedSugarsG       Decimal?  @map("added_sugars_g") @db.Decimal(10, 4)
  sodiumMg           Decimal?  @map("sodium_mg") @db.Decimal(14, 4)
  potassiumMg        Decimal?  @map("potassium_mg") @db.Decimal(14, 4)
  calciumMg          Decimal?  @map("calcium_mg") @db.Decimal(12, 4)
  ironMg             Decimal?  @map("iron_mg") @db.Decimal(12, 4)
  magnesiumMg        Decimal?  @map("magnesium_mg") @db.Decimal(12, 4)
  zincMg             Decimal?  @map("zinc_mg") @db.Decimal(12, 4)
  vitaminCMg         Decimal?  @map("vitamin_c_mg") @db.Decimal(12, 4)
  vitaminDIu         Decimal?  @map("vitamin_d_iu") @db.Decimal(12, 4)
  vitaminARaeUg      Decimal?  @map("vitamin_a_rae_ug") @db.Decimal(12, 4)
  vitaminB12Ug       Decimal?  @map("vitamin_b12_ug") @db.Decimal(12, 4)
  folateDfeUg        Decimal?  @map("folate_dfe_ug") @db.Decimal(12, 4)
  dataFlags          String?   @map("data_flags") @db.Text
  priceSnapshotDate  DateTime  @default(now()) @map("price_snapshot_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([fdcId])
  @@index([department])
  @@map("grocery_items")
}
