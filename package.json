{
  "name": "smart-savor",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Savor — fullstack Next.js app (dietitian console at / + patient app at /me + /api route handlers). One project: single package.json, tsconfig, node_modules.",
  "scripts": {
    "predev": "docker compose up -d",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.19",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "^5.22.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.1",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "5.5.3"
  }
}
