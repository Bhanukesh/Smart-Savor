{
  "name": "smart-savor",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Savor — fullstack Next.js app (dietitian /rx + patient /me + /api route handlers). One project: single package.json, tsconfig, node_modules.",
  "scripts": {
    "predev": "docker compose up -d",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.5.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.1",
    "@types/node": "^20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "5.5.3"
  }
}
